// See config docs here: https://opencode.ai/docs/config
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "/etc/opencode/AGENTS.md"
  ],
  "autoupdate": false,
  "model": "google-vertex/gemini-3.5-flash",
  "enabled_providers": ["google-vertex"],
  "provider": {
    "google-vertex": {
      "options": {
        "project": "{env:DAPLA_TEAM_GOOGLE_PROJECT_ID}",
        "location": "europe-west2" // London
      }
    }
  },
  "permission": {
    "read": {
      "/buckets/**": "ask",
      "*": "allow"
    },
    "edit": "ask",
    "write": "ask",
    "bash": "ask"
  }
}
